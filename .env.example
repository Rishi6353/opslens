# ==============================================================================
# OpsLens Environment Variables Configuration Template
# Copy this file to .env: `cp .env.example .env`
# NEVER commit real .env files with production secrets to version control!
# ==============================================================================

# Application Environment ('development' or 'production')
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001

# Flask Application Entry Point
FLASK_APP=run.py

# Cryptographic Secret Key
# Required for signing session cookies and generating CSRF tokens.
# In development, you may use the placeholder below.
# IN PRODUCTION: You MUST generate a 64-character (32-byte) hex secret key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If FLASK_ENV=production, OpsLens will fail to start if SECRET_KEY is missing or <32 chars.
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-string-for-prod

# Database Configuration (Relative to workspace root or absolute path)
DATABASE_PATH=instance/opslens.db
